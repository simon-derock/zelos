<script>
(function () {
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var deck = document.getElementById('deck');
  var notes = document.getElementById('notes');
  var count = document.getElementById('count');
  var bar = document.getElementById('bar');
  var cur = 0;
  var qs = location.search;
  if (/(^|[?&])print(&|=|$)/.test(qs)) { document.documentElement.classList.add('print'); }
  var printing = document.documentElement.classList.contains('print');

  function fit() {
    if (printing) { return; }
    var notesOn = document.body.classList.contains('notes');
    var reserve = notesOn ? window.innerHeight * 0.30 : 0;
    var s = Math.min(window.innerWidth / 1920, (window.innerHeight - reserve) / 1080);
    deck.style.setProperty('--s', s);
    deck.style.setProperty('--dy', (-reserve / 2) + 'px');
  }
  function show(n) {
    cur = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach(function (el, i) { el.classList.toggle('on', i === cur); });
    count.textContent = (cur + 1) + ' / ' + slides.length;
    bar.style.width = (100 * (cur + 1) / slides.length) + '%';
    var a = slides[cur].querySelector('aside.notes');
    notes.innerHTML = '<b>Speaker notes &middot; slide ' + (cur + 1) + '</b><br>' + (a ? a.innerHTML : '');
    try { history.replaceState(null, '', '#' + (cur + 1)); } catch (e) { /* file:// in some browsers */ }
  }
  function toggleNotes() { document.body.classList.toggle('notes'); fit(); }
  document.addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) { return; }
    var k = e.key;
    if (k === 'ArrowRight' || k === ' ' || k === 'PageDown' || k === 'Enter') { show(cur + 1); e.preventDefault(); }
    else if (k === 'ArrowLeft' || k === 'PageUp' || k === 'Backspace') { show(cur - 1); e.preventDefault(); }
    else if (k === 'Home') { show(0); }
    else if (k === 'End') { show(slides.length - 1); }
    else if (k === 'n' || k === 'N') { toggleNotes(); }
    else if (k === 'f' || k === 'F') {
      if (document.fullscreenElement) { document.exitFullscreen(); } else if (document.documentElement.requestFullscreen) { document.documentElement.requestFullscreen(); }
    }
  });
  document.addEventListener('click', function (e) {
    if (printing || e.target.closest('#notes') || e.target.closest('a')) { return; }
    show(cur + (e.clientX < window.innerWidth / 3 ? -1 : 1));
  });
  var touchX = null;
  document.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
  document.addEventListener('touchend', function (e) {
    if (touchX === null) { return; }
    var dx = e.changedTouches[0].clientX - touchX; touchX = null;
    if (Math.abs(dx) > 50) { show(cur + (dx < 0 ? 1 : -1)); }
  }, { passive: true });
  window.addEventListener('resize', fit);
  window.addEventListener('hashchange', function () { var n = parseInt(location.hash.slice(1), 10); if (n) { show(n - 1); } });
  if (/(^|[?&])notes(&|=|$)/.test(qs)) { document.body.classList.add('notes'); }
  var start = parseInt(location.hash.slice(1), 10);
  show(start ? start - 1 : 0);
  fit();
})();
</script>
